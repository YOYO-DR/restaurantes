# .env.local.example — plantilla del entorno LOCAL (desarrollo)
# ---------------------------------------------------------------------------
# Primer arranque:  cp .env.local.example .env
# Después:          docker compose -f docker-compose.local.yml up -d
#
# Este fichero NO lo lee ningún proceso: es la plantilla versionada. El .env de
# la raíz (gitignored) es el único que usan:
#   · docker-compose.local.yml → env_file de django, celeryworker, celerybeat,
#     flower, postgres, pgbouncer y frontend, y la interpolación ${...} (puertos).
#   · Django fuera de Docker (DJANGO_READ_DOT_ENV_FILE=True) → config/settings/base.py.
#   · Vite en el host (pnpm dev / build) → frontend/vite.config.js.
# Los valores de abajo son de desarrollo y no secretos.
# ---------------------------------------------------------------------------

# ══════════════════════════════════════════════════════════════════════════
# Puertos del host (solo los lee docker-compose.local.yml)
# Cámbialos si chocan con otro stack local. Si cambias DJANGO_PORT o
# FRONTEND_PORT, ajusta también VITE_API_URL, FRONTEND_URL y los orígenes.
# ══════════════════════════════════════════════════════════════════════════
DJANGO_PORT=8000
FRONTEND_PORT=5174
PGBOUNCER_PORT=6432
FLOWER_PORT=5555
REDISINSIGHT_PORT=5540

# ══════════════════════════════════════════════════════════════════════════
# Django · django, celeryworker, celerybeat, flower
# ══════════════════════════════════════════════════════════════════════════

# Entorno de Docker (config/settings/local.py → INTERNAL_IPS del debug toolbar).
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
# Orígenes de CSRF y CORS (base.py). 5174 = Vite en Docker, 5173 = Vite en el host.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://localhost:5173,http://192.168.1.39:5174,http://192.168.1.39:5173,https://localhost:5174,https://localhost:5173,https://192.168.1.39:5174,https://192.168.1.39:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://192.168.1.39:5174,http://192.168.1.39:5173,https://localhost:5174,https://localhost:5173,https://192.168.1.39:5174,https://192.168.1.39:5173
# Nombre del fichero de log en backend/logs/ (base.py → LOGGING).
DJANGO_NAME_LOG_FILE=django_dev
# URL del frontend: base de los enlaces de los correos (base.py → FRONTEND_URL).
FRONTEND_URL=http://localhost:5174

# Redis (base.py → REDIS_URL).
REDIS_URL=redis://redis:6379/0

# Basic auth de Flower (compose/local/django/celery/flower/start).
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# Correo (local.py). En local, consola. Para Resend: anymail.backends.resend.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
# PostgreSQL · postgres, pgbouncer y DATABASE_URL de Django
# ══════════════════════════════════════════════════════════════════════════
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yodumanager
POSTGRES_USER=debug
POSTGRES_PASSWORD=debug

PGB_POSTGRES_HOST=pgbouncer
PGB_POSTGRES_PORT=6432
PGB_POSTGRES_DB=${POSTGRES_DB}
PGB_POSTGRES_USER=${POSTGRES_USER}
PGB_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

DATABASE_URL=postgres://${PGB_POSTGRES_USER}:${PGB_POSTGRES_PASSWORD}@${PGB_POSTGRES_HOST}:${PGB_POSTGRES_PORT}/${PGB_POSTGRES_DB}

# ══════════════════════════════════════════════════════════════════════════
# Frontend · Vite (frontend/vite.config.js lee este .env de la raíz)
# ══════════════════════════════════════════════════════════════════════════
# Debe apuntar al puerto publicado de Django (DJANGO_PORT).
VITE_API_URL=http://localhost:8000
