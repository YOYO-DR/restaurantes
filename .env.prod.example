# .env.prod.example — plantilla del entorno de PRODUCCIÓN (Dokploy)
# ---------------------------------------------------------------------------
# Documentación de qué claves necesita producción y en qué servicio aplica.
# Este fichero NO lo lee ningún proceso. Solo nombres y marcadores (CAMBIAR,
# ejemplo.com…), NUNCA valores reales. El .env real vive en el servidor y está
# gitignored.
#
# Cómo se usa el .env de producción:
#   · `docker-compose.dokploy.yml` lee ./.env con `env_file` en django,
#     celeryworker, celerybeat, pgbouncer y traefik, y lo interpola para los
#     límites de CPU/RAM, las réplicas y el build arg VITE_API_URL del frontend.
#   · Se crea en el servidor (pestaña Environment de Dokploy) o, con el flujo de
#     cookiecutter, `backend/merge_production_dotenvs_in_dotenv.py` concatena
#     `backend/.envs/.production/.django` + `.postgres` (solo existen en el servidor).
#   · El arranque de django corre `collectstatic` y `migrate` y levanta gunicorn
#     (backend/compose/production/django/start).
# Obligatoria = sin default en el código: si falta, el servicio no arranca.
# ---------------------------------------------------------------------------

# ══════════════════════════════════════════════════════════════════════════
# Django · django, celeryworker, celerybeat
# ══════════════════════════════════════════════════════════════════════════

# Obligatoria en la práctica. config/asgi.py y config/celery_app.py caen a
# config.settings.local si falta, y el arranque de producción usa config.asgi.
DJANGO_SETTINGS_MODULE=config.settings.production
# Clave secreta de Django y de la firma JWT (production.py → SECRET_KEY y
# base.py → SIMPLE_JWT). Obligatoria. Rotarla invalida las sesiones.
DJANGO_SECRET_KEY=CAMBIAR
# Ruta del admin (production.py → ADMIN_URL). Obligatoria.
DJANGO_ADMIN_URL=CAMBIAR-ruta-admin/
# Hosts permitidos (production.py → ALLOWED_HOSTS). Lista separada por comas.
# Default en el código: restaurant.yoyodr.dev.
DJANGO_ALLOWED_HOSTS=CAMBIAR-dominio.com
# Orígenes de CSRF (base.py → CSRF_TRUSTED_ORIGINS). Obligatoria, sin default.
DJANGO_CSRF_TRUSTED_ORIGINS=https://CAMBIAR-dominio.com
# Orígenes permitidos para CORS (base.py → CORS_ALLOWED_ORIGINS, default vacío).
DJANGO_CORS_ALLOWED_ORIGINS=https://CAMBIAR-dominio.com
# Nombre del fichero de log en /app/logs/ (base.py → LOGGING, default "django").
DJANGO_NAME_LOG_FILE=django
# Modo debug (base.py → DEBUG, default false). Dejarlo en false.
DJANGO_DEBUG=false
# Redirect a HTTPS (production.py → SECURE_SSL_REDIRECT, default true).
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS (production.py; los dos con default true).
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
# Redis (base.py → REDIS_URL: caché, broker de Celery y capa de canales de Channels).
# El default apunta al host `redis`, que en Dokploy no existe (docker-compose.dokploy.yml
# no tiene servicio redis): hay que poner un Redis alcanzable.
REDIS_URL=redis://CAMBIAR-host-redis:6379/0
# true en producción: la cookie del refresh token solo viaja por HTTPS
# (base.py → JWT_REFRESH_COOKIE_SECURE, default `not DEBUG`).
JWT_REFRESH_COOKIE_SECURE=true
# SameSite de esa cookie (base.py → JWT_REFRESH_COOKIE_SAMESITE, default Lax).
JWT_REFRESH_COOKIE_SAMESITE=Lax
# Origen del frontend: base de los enlaces de invitación de operadores
# (base.py → FRONTEND_URL; el default es localhost, hay que cambiarlo).
FRONTEND_URL=https://CAMBIAR-dominio.com

# Correo. Producción usa Resend vía anymail (production.py fija el backend).
# API key de Resend (production.py → ANYMAIL). Obligatoria. CAMBIAR.
RESEND_API_KEY=CAMBIAR
# Remitente de los correos (production.py → DEFAULT_FROM_EMAIL).
DJANGO_DEFAULT_FROM_EMAIL=Restaurante <no-reply@CAMBIAR-dominio.com>
# Remitente de los correos de servidor (production.py → SERVER_EMAIL, default = el de arriba).
DJANGO_SERVER_EMAIL=Restaurante <no-reply@CAMBIAR-dominio.com>
# Prefijo del asunto (production.py → EMAIL_SUBJECT_PREFIX).
DJANGO_EMAIL_SUBJECT_PREFIX=[Restaurante]

# Sentry (production.py). SENTRY_DSN es obligatoria, pero puede ir vacía para
# desactivar el envío de errores.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DJANGO_SENTRY_LOG_LEVEL=20

# Workers de gunicorn del contenedor django. Opcional: gunicorn lee WEB_CONCURRENCY
# por su cuenta (sin ella usa 1).
WEB_CONCURRENCY=2
# Réplicas del servicio celeryworker (docker-compose.dokploy.yml, default 2).
CANT_WORKERS_CELERY=2

# ══════════════════════════════════════════════════════════════════════════
# PostgreSQL y PgBouncer · postgres (gestionado fuera del compose), pgbouncer, django
# ══════════════════════════════════════════════════════════════════════════

# compose/production/django/entrypoint arma DATABASE_URL con estas cinco variables
# (postgres://USER:PASSWORD@HOST:PORT/DB) y espera a que HOST:PORT responda. No hace
# falta definir DATABASE_URL: el entrypoint la sobrescribe.
# pgbouncer usa las mismas como upstream (pgbouncer.ini.template; su entrypoint.sh
# exige POSTGRES_USER y POSTGRES_PASSWORD). Todas obligatorias.
POSTGRES_HOST=CAMBIAR-host-postgres
POSTGRES_PORT=5432
POSTGRES_DB=CAMBIAR-nombre-bd
POSTGRES_USER=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR

# ══════════════════════════════════════════════════════════════════════════
# Frontend · build arg VITE_API_URL de frontend/compose/production/Dockerfile
# (docker-compose.dokploy.yml lo interpola desde este .env)
# ══════════════════════════════════════════════════════════════════════════

# Origen de la API tal como lo ve el navegador, incrustado en el bundle en el build.
# El front le añade rutas que ya empiezan por /api (y deriva de aquí el WebSocket),
# así que va solo el origen: https://CAMBIAR-dominio.com
VITE_API_URL=https://CAMBIAR-dominio.com

# ══════════════════════════════════════════════════════════════════════════
# Traefik · enrutado (traefik.template.yml, resuelto con envsubst al arrancar)
# ══════════════════════════════════════════════════════════════════════════

# Dominio público para las reglas Host(...). Obligatoria.
DOMAIN=CAMBIAR-dominio.com

# ══════════════════════════════════════════════════════════════════════════
# Dokploy · límites de recursos (docker-compose.dokploy.yml, con default :- si faltan)
# ══════════════════════════════════════════════════════════════════════════
DJANGO_CPU=1
DJANGO_RAM=1g
PGBOUNCER_CPU=1
PGBOUNCER_RAM=1g
TRAEFIK_CPU=1
TRAEFIK_RAM=1g
CELERYWORKER_CPU=1
CELERYWORKER_RAM=1g
CELERYBEAT_CPU=1
CELERYBEAT_RAM=1g
NGINX_CPU=1
NGINX_RAM=1g
FRONTEND_CPU=1
FRONTEND_RAM=1g
