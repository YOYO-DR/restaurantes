# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# Database
DATABASE_URL=postgres://${PGB_POSTGRES_USER}:${PGB_POSTGRES_PASSWORD}@${PGB_POSTGRES_HOST}:${PGB_POSTGRES_PORT}/${PGB_POSTGRES_DB}

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.39:5173,https://localhost:5173,https://192.168.1.39:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.39:5173,https://localhost:5173,https://192.168.1.39:5173
DJANGO_NAME_LOG_FILE=django_dev

